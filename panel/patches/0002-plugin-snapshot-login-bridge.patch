diff --git a/src/features/plugins/pluginSnapshotBridge.ts b/src/features/plugins/pluginSnapshotBridge.ts
new file mode 100644
index 0000000..5a1cde4
--- /dev/null
+++ b/src/features/plugins/pluginSnapshotBridge.ts
@@ -0,0 +1,60 @@
+type Options = {
+  origin: string;
+  frame: () => Window | null;
+  document: () => Document | null;
+  readSnapshot: () => Promise<unknown>;
+  current: () => boolean;
+};
+
+/** Read-only, same-origin capability for the currently mounted plugin frame. */
+export function createPluginSnapshotBridge(options: Options) {
+  let disposed = false;
+  let pending = false;
+  const document = options.document();
+  const valid = (source: MessageEventSource | null) =>
+    !disposed &&
+    options.current() &&
+    document !== null &&
+    options.document() === document &&
+    source !== null &&
+    source === options.frame();
+
+  return {
+    async receive(event: MessageEvent) {
+      const data: unknown = event.data;
+      if (
+        pending ||
+        event.origin !== options.origin ||
+        !valid(event.source) ||
+        !data ||
+        typeof data !== 'object' ||
+        Array.isArray(data)
+      )
+        return;
+      const request = data as Record<string, unknown>;
+      if (
+        Object.keys(request).length !== 2 ||
+        request.type !== 'cpa.plugin.snapshot.request.v1' ||
+        typeof request.requestId !== 'string' ||
+        !/^[A-Za-z0-9-]{1,64}$/.test(request.requestId)
+      )
+        return;
+      pending = true;
+      const response: Record<string, unknown> = {
+        type: 'cpa.plugin.snapshot.response.v1',
+        requestId: request.requestId,
+      };
+      try {
+        response.snapshot = await options.readSnapshot();
+      } catch {
+        response.error = 'unavailable';
+      } finally {
+        pending = false;
+      }
+      if (valid(event.source)) options.frame()?.postMessage(response, options.origin);
+    },
+    dispose() {
+      disposed = true;
+    },
+  };
+}
