@@ -0,0 +1,119 @@
+import { useTranslation } from 'react-i18next';
+import { Card } from '@/components/ui/Card';
+import { Button } from '@/components/ui/Button';
+import type { XiaomiState } from './model';
+import { displayCredits } from './model';
+import styles from './XiaomiQuotaCard.module.scss';
+
+interface Props {
+  state: XiaomiState;
+  loading: boolean;
+  disabled: boolean;
+  onRefresh: () => void;
+  now: number;
+}
+export function XiaomiQuotaCard({ state, loading, disabled, onRefresh, now }: Props) {
+  const { t } = useTranslation();
+  const s = state.kind === 'ready' ? state.snapshot : null;
+  const stale =
+    s &&
+    (s.stale ||
+      !s.fetchedAt ||
+      now - Date.parse(s.fetchedAt) > 600000 ||
+      now < Date.parse(s.fetchedAt));
+  return (
+    <Card
+      title={t('xiaomi_quota.title')}
+      extra={
+        <Button
+          variant="secondary"
+          size="sm"
+          loading={loading}
+          disabled={disabled}
+          onClick={onRefresh}
+        >
+          {t('xiaomi_quota.refresh')}
+        </Button>
+      }
+    >
+      <div className={styles.content} aria-live="polite">
+        <p>
+          {t('xiaomi_quota.source')} · {t('xiaomi_quota.region')}
+        </p>
+        {state.kind !== 'ready' && <p role="status">{t('xiaomi_quota.' + state.kind)}</p>}
+        {s && (
+          <>
+            <p>
+              <strong>{s.accountLabel}</strong>
+              {s.planName ? ' · ' + s.planName : ''}
+            </p>
+            <p role="status">
+              {s.error && <span>{t('xiaomi_quota.' + s.error)} · </span>}
+              {stale && <span>{t('xiaomi_quota.stale')} · </span>}
+              {(s.expired || (s.expiresAt && now >= Date.parse(s.expiresAt))) && (
+                <span>{t('xiaomi_quota.expired')}</span>
+              )}
+            </p>
+            <div className={styles.pools}>
+              {s.pools.map((pool) => (
+                <section className={styles.pool} key={pool.id}>
+                  <strong>{t('xiaomi_quota.' + pool.id)}</strong>
+                  <dl>
+                    <div>
+                      <dt>{t('xiaomi_quota.remaining')}</dt>
+                      <dd>
+                        {displayCredits(pool.remaining)} Credits
+                        {pool.remainingPercent !== null && ' (' + pool.remainingPercent + '%)'}
+                      </dd>
+                    </div>
+                    <div>
+                      <dt>{t('xiaomi_quota.used')}</dt>
+                      <dd>
+                        {displayCredits(pool.used)} / {displayCredits(pool.limit)} Credits
+                      </dd>
+                    </div>
+                  </dl>
+                  {pool.remainingPercent !== null && (
+                    <progress
+                      max={100}
+                      value={Number(pool.remainingPercent)}
+                      aria-label={t('xiaomi_quota.remaining')}
+                    />
+                  )}
+                </section>
+              ))}
+            </div>
+            <dl>
+              <div>
+                <dt>{t('xiaomi_quota.checked')}</dt>
+                <dd>
+                  {s.fetchedAt ? (
+                    <time dateTime={s.fetchedAt}>{s.fetchedAt}</time>
+                  ) : (
+                    t('xiaomi_quota.unknown')
+                  )}
+                </dd>
+              </div>
+              {s.expiresAt && (
+                <div>
+                  <dt>{t('xiaomi_quota.valid_until')}</dt>
+                  <dd>
+                    <time dateTime={s.expiresAt}>{s.expiresAt}</time>
+                  </dd>
+                </div>
+              )}
+            </dl>
+          </>
+        )}
+        <p>{t('xiaomi_quota.delay')}</p>
+        <a
+          href="https://platform.xiaomimimo.com/#/console/plan-manage"
+          target="_blank"
+          rel="noopener noreferrer"
+        >
+          {t('xiaomi_quota.console')}
+        </a>
+      </div>
+    </Card>
+  );
+}
diff --git a/src/features/quota/xiaomi/XiaomiQuotaSection.tsx b/src/features/quota/xiaomi/XiaomiQuotaSection.tsx
new file mode 100644
index 0000000..f1c805d
--- /dev/null
+++ b/src/features/quota/xiaomi/XiaomiQuotaSection.tsx
@@ -0,0 +1,60 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { providersApi } from '@/services/api/providers';
+import { useQuotaStore } from '@/stores';
+import { useNow } from '@/hooks/useNow';
+import { XiaomiQuotaCard } from './XiaomiQuotaCard';
+import { fetchXiaomiQuota, hasSingaporePlan, type XiaomiState } from './model';
+
+/** Independent config source: never depends on auth-file enumeration or provider aliases. */
+export function XiaomiQuotaSection({ disabled }: { disabled: boolean }) {
+  const generation = useQuotaStore((s) => s.cacheGeneration);
+  const [state, setState] = useState<XiaomiState>({ kind: 'loading' });
+  const [loading, setLoading] = useState(false);
+  const active = useRef<AbortController | null>(null);
+  const now = useNow(!disabled && state.kind === 'ready');
+  const load = useCallback(async () => {
+    active.current?.abort();
+    const controller = new AbortController();
+    active.current = controller;
+    const current = () =>
+      !controller.signal.aborted && useQuotaStore.getState().cacheGeneration === generation;
+    if (disabled) {
+      setState({ kind: 'unavailable' });
+      setLoading(false);
+      return;
+    }
+    setLoading(true);
+    setState({ kind: 'loading' });
+    try {
+      const providers = await providersApi.getOpenAIProviders();
+      if (!current()) return;
+      if (!hasSingaporePlan(providers)) {
+        setState({ kind: 'unconfigured' });
+        return;
+      }
+      const snapshot = await fetchXiaomiQuota(controller.signal);
+      if (current()) setState({ kind: 'ready', snapshot });
+    } catch {
+      if (current()) setState({ kind: 'unavailable' });
+    } finally {
+      if (current()) setLoading(false);
+    }
+  }, [disabled, generation]);
+  useEffect(() => {
+    void load();
+    return () => {
+      active.current?.abort();
+    };
+  }, [load]);
+  return (
+    <XiaomiQuotaCard
+      state={disabled ? { kind: 'unavailable' } : state}
+      loading={loading}
+      disabled={disabled}
+      onRefresh={() => {
+        void load();
+      }}
+      now={now}
+    />
+  );
+}
diff --git a/src/features/quota/xiaomi/credit.ts b/src/features/quota/xiaomi/credit.ts
new file mode 100644
index 0000000..012b8bd
--- /dev/null
+++ b/src/features/quota/xiaomi/credit.ts
@@ -0,0 +1,41 @@
+/** Exact decimal Credits. Numeric JSON must be safe integers; fractions need strings. */
+export function credit(input: unknown): string {
+  if (typeof input === 'number') {
+    if (!Number.isSafeInteger(input) || input < 0) throw new Error('Invalid Credits');
+    input = String(input);
+  }
+  if (typeof input !== 'string' || input.length > 128 || !/^\d+(?:\.\d{1,18})?$/.test(input)) {
+    throw new Error('Invalid Credits');
+  }
+  const [whole, fraction = ''] = input.split('.');
+  const normalized = whole.replace(/^0+(?=\d)/, '');
+  const tail = fraction.replace(/0+$/, '');
+  return normalized + (tail ? '.' + tail : '');
+}
+function scaled(value: string, digits: number): bigint {
+  const [whole, fraction = ''] = value.split('.');
+  return BigInt(whole + fraction.padEnd(digits, '0'));
+}
+function decimal(value: bigint, digits: number): string {
+  if (!digits) return value.toString();
+  const raw = value.toString().padStart(digits + 1, '0');
+  return credit(raw.slice(0, -digits) + '.' + raw.slice(-digits));
+}
+export function balance(usedValue: unknown, limitValue: unknown) {
+  const used = credit(usedValue),
+    limit = credit(limitValue);
+  const digits = Math.max(used.split('.')[1]?.length ?? 0, limit.split('.')[1]?.length ?? 0);
+  const u = scaled(used, digits),
+    l = scaled(limit, digits);
+  const remaining = l > u ? l - u : 0n;
+  const hundredths = l ? (remaining * 10000n + l / 2n) / l : null;
+  return {
+    used,
+    limit,
+    remaining: decimal(remaining, digits),
+    remainingPercent:
+      hundredths === null
+        ? null
+        : (hundredths / 100n).toString() + '.' + (hundredths % 100n).toString().padStart(2, '0'),
+  };
+}
diff --git a/src/features/quota/xiaomi/model.ts b/src/features/quota/xiaomi/model.ts
new file mode 100644
index 0000000..60f2aed
--- /dev/null
+++ b/src/features/quota/xiaomi/model.ts
@@ -0,0 +1,131 @@
+import { apiCallApi } from '@/services/api/apiCall';
+import { balance } from './credit';
+import type { QuotaSnapshot, QuotaPool, QuotaErrorCode } from './types';
+
+export type XiaomiState =
+  { kind: 'loading' | 'unconfigured' | 'unavailable' } | { kind: 'ready'; snapshot: QuotaSnapshot };
+const record = (v: unknown): v is Record<string, unknown> =>
+  typeof v === 'object' && v !== null && !Array.isArray(v);
+const invalid = (): never => {
+  throw new Error('Invalid Xiaomi quota snapshot');
+};
+const instant = (v: unknown): string | null => {
+  if (v === null) return null;
+  if (
+    typeof v !== 'string' ||
+    !/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z$/.test(v) ||
+    !Number.isFinite(Date.parse(v)) ||
+    new Date(v).toISOString() !== v
+  )
+    return invalid();
+  return v;
+};
+export function hasSingaporePlan(providers: unknown): boolean {
+  return (
+    Array.isArray(providers) &&
+    providers.some(
+      (p) =>
+        record(p) &&
+        p.disabled !== true &&
+        typeof p.baseUrl === 'string' &&
+        /^https:\/\/token-plan-sgp\.xiaomimimo\.com\/v1\/?$/.test(p.baseUrl)
+    )
+  );
+}
+export function parseSnapshot(value: unknown): QuotaSnapshot {
+  if (
+    !record(value) ||
+    value.schemaVersion !== 1 ||
+    value.region !== 'sgp' ||
+    typeof value.accountLabel !== 'string' ||
+    !value.accountLabel.trim() ||
+    value.accountLabel.length > 80 ||
+    Array.from(value.accountLabel).some((c) => c.charCodeAt(0) < 32 || c.charCodeAt(0) === 127) ||
+    typeof value.stale !== 'boolean' ||
+    (value.expired !== null && typeof value.expired !== 'boolean') ||
+    value.resetsAt !== null
+  )
+    return invalid();
+  const errors: (QuotaErrorCode | null)[] = [
+    null,
+    'auth_required',
+    'unavailable',
+    'schema_changed',
+  ];
+  if (
+    !errors.includes(value.error as QuotaErrorCode | null) ||
+    !Array.isArray(value.pools) ||
+    value.pools.length > 3
+  )
+    return invalid();
+  const names: Record<string, string> = {
+    plan: 'Plan Credits',
+    monthly: 'Monthly Credits (overlapping)',
+    compensation: 'Compensation Credits',
+  };
+  const ids = new Set<string>();
+  const pools = value.pools.map((p: unknown): QuotaPool => {
+    if (
+      !record(p) ||
+      typeof p.id !== 'string' ||
+      !Object.prototype.hasOwnProperty.call(names, p.id) ||
+      ids.has(p.id) ||
+      p.unit !== 'credits' ||
+      typeof p.used !== 'string' ||
+      typeof p.limit !== 'string'
+    )
+      return invalid();
+    ids.add(p.id);
+    const counters = balance(p.used, p.limit);
+    if (
+      counters.used !== p.used ||
+      counters.limit !== p.limit ||
+      counters.remaining !== p.remaining ||
+      counters.remainingPercent !== p.remainingPercent
+    )
+      return invalid();
+    return { id: p.id as QuotaPool['id'], label: names[p.id], unit: 'credits', ...counters };
+  });
+  const fetchedAt = instant(value.fetchedAt),
+    expiresAt = instant(value.expiresAt);
+  if (
+    value.error === null &&
+    (!fetchedAt || !ids.has('plan') || !ids.has('monthly') || value.expired === null)
+  )
+    return invalid();
+  if (
+    value.planName !== null &&
+    !['Lite', 'Standard', 'Pro', 'Max', 'Ultra'].includes(value.planName as string)
+  )
+    return invalid();
+  return {
+    schemaVersion: 1,
+    region: 'sgp',
+    accountLabel: value.accountLabel,
+    planName: value.planName as string | null,
+    pools,
+    fetchedAt,
+    expiresAt,
+    expired: value.expired as boolean | null,
+    resetsAt: null,
+    stale: value.stale || value.error !== null,
+    error: value.error as QuotaErrorCode | null,
+  };
+}
+export async function fetchXiaomiQuota(signal?: AbortSignal): Promise<QuotaSnapshot> {
+  const result = await apiCallApi.request(
+    {
+      method: 'GET',
+      url: 'http://xiaomi-quota:8787/v1/quota',
+      proxy_url: 'direct',
+    },
+    { timeout: 15000, signal }
+  );
+  if (result.statusCode !== 200) throw new Error('Xiaomi quota unavailable');
+  return parseSnapshot(result.body);
+}
+/** Group decimal strings without lossy Number conversion. */
+export function displayCredits(value: string): string {
+  const [whole, tail] = value.split('.');
+  return whole.replace(/\B(?=(\d{3})+(?!\d))/g, ',') + (tail ? '.' + tail : '');
+}
