diff --git a/tests/xiaomiQuota.test.ts b/tests/xiaomiQuota.test.ts
new file mode 100644
index 0000000..8f086e2
--- /dev/null
+++ b/tests/xiaomiQuota.test.ts
@@ -0,0 +1,191 @@
+import { expect, mock, spyOn, test } from 'bun:test';
+import i18n from '../src/i18n/index';
+import { I18nextProvider } from 'react-i18next';
+const english = i18n.cloneInstance({ lng: 'en' });
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { apiCallApi } from '../src/services/api/apiCall';
+import {
+  hasSingaporePlan,
+  fetchXiaomiQuota,
+  parseSnapshot,
+} from '../src/features/quota/xiaomi/model';
+import { XiaomiQuotaCard } from '../src/features/quota/xiaomi/XiaomiQuotaCard';
+import type { QuotaSnapshot } from '../src/features/quota/xiaomi/types';
+import { QUOTA_CLASS_KEYS } from '../src/features/quota/types';
+const sample: QuotaSnapshot = {
+  schemaVersion: 1,
+  region: 'sgp',
+  accountLabel: 'Synthetic Singapore',
+  planName: 'Standard',
+  pools: [
+    {
+      id: 'plan',
+      label: 'Plan Credits',
+      unit: 'credits',
+      used: '6000000000',
+      limit: '11000000000',
+      remaining: '5000000000',
+      remainingPercent: '45.45',
+    },
+    {
+      id: 'monthly',
+      label: 'Monthly Credits (overlapping)',
+      unit: 'credits',
+      used: '6000000000',
+      limit: '11000000000',
+      remaining: '5000000000',
+      remainingPercent: '45.45',
+    },
+    {
+      id: 'compensation',
+      label: 'Compensation Credits',
+      unit: 'credits',
+      used: '0',
+      limit: '0',
+      remaining: '0',
+      remainingPercent: null,
+    },
+  ],
+  fetchedAt: '2030-01-01T00:00:00.000Z',
+  expiresAt: '2030-01-31T23:59:59.000Z',
+  expired: false,
+  resetsAt: null,
+  stale: false,
+  error: null,
+};
+const render = (
+  state: Parameters<typeof XiaomiQuotaCard>[0]['state'],
+  now = Date.parse('2030-01-01T00:00:00Z')
+) =>
+  renderToStaticMarkup(
+    createElement(
+      I18nextProvider,
+      { i18n: english },
+      createElement(XiaomiQuotaCard, {
+        state,
+        loading: false,
+        disabled: false,
+        onRefresh: () => {},
+        now,
+      })
+    )
+  );
+
+test('quota page mounts Xiaomi independently while OAuth file list is still empty', async () => {
+  // Bun does not implement Vite CSS Modules. Substitute only that build boundary,
+  // retaining the real page, providers, card and empty auth-file state.
+  mock.module('../src/features/quota/components/QuotaBody.module.scss', () => ({
+    default: Object.fromEntries(QUOTA_CLASS_KEYS.map((k) => [k, k])),
+  }));
+  mock.module('../src/features/quota/QuotaPage.module.scss', () => ({
+    default: { page: 'page', workbench: 'workbench', search: 'search' },
+  }));
+  const { QuotaPage } = await import('../src/features/quota/QuotaPage');
+  const html = renderToStaticMarkup(
+    createElement(I18nextProvider, { i18n: english }, createElement(QuotaPage))
+  );
+  expect(html).toContain('Xiaomi MiMo Token Plan');
+  expect(html).toContain('https://platform.xiaomimimo.com/#/console/plan-manage');
+});
+test('config-only Singapore provider needs no auth file or inference key to qualify', () => {
+  expect(
+    hasSingaporePlan([{ baseUrl: 'https://token-plan-sgp.xiaomimimo.com/v1', name: 'Any alias' }])
+  ).toBe(true);
+  expect(
+    hasSingaporePlan([{ baseUrl: 'https://token-plan-sgp.xiaomimimo.com/v1/', disabled: false }])
+  ).toBe(true);
+  for (const providers of [
+    [],
+    [{ baseUrl: 'https://api.xiaomimimo.com/v1', name: 'xiaomi' }],
+    [{ baseUrl: 'https://token-plan-sgp.xiaomimimo.com.evil.invalid/v1' }],
+    [{ baseUrl: 'https://token-plan-sgp.xiaomimimo.com/v1', disabled: true }],
+  ])
+    expect(hasSingaporePlan(providers)).toBe(false);
+});
+test('management request targets fixed private collector with no vendor credentials', async () => {
+  const proxy = spyOn(apiCallApi, 'request').mockResolvedValue({
+    statusCode: 200,
+    header: {},
+    bodyText: '',
+    body: sample,
+  });
+  try {
+    expect(await fetchXiaomiQuota()).toEqual(sample);
+    const request = proxy.mock.calls[0][0];
+    expect(request).toEqual({
+      method: 'GET',
+      url: 'http://xiaomi-quota:8787/v1/quota',
+      proxy_url: 'direct',
+    });
+    expect(JSON.stringify(request)).not.toMatch(/cookie|authIndex|TOKEN|api.key/i);
+  } finally {
+    proxy.mockRestore();
+  }
+});
+test('outer proxy failure, schema drift and invented balance fail closed', async () => {
+  const proxy = spyOn(apiCallApi, 'request').mockResolvedValue({
+    statusCode: 401,
+    header: {},
+    bodyText: 'private',
+    body: sample,
+  });
+  try {
+    await expect(fetchXiaomiQuota()).rejects.toThrow();
+  } finally {
+    proxy.mockRestore();
+  }
+  for (const bad of [
+    { ...sample, region: 'cn' },
+    { ...sample, schemaVersion: 2 },
+    { ...sample, pools: [] },
+    { ...sample, pools: [sample.pools[0], sample.pools[0]] },
+    { ...sample, pools: [{ ...sample.pools[0], remaining: '999' }, sample.pools[1]] },
+    { ...sample, fetchedAt: '2030-02-30T00:00:00.000Z' },
+  ])
+    expect(() => parseSnapshot(bad)).toThrow();
+});
+test('real card renders Credits, distinct overlapping pools, identity and validity, not reset', () => {
+  const html = render({ kind: 'ready', snapshot: sample });
+  for (const text of [
+    '5,000,000,000',
+    '6,000,000,000',
+    '11,000,000,000',
+    '45.45%',
+    'Credits',
+    'Synthetic Singapore',
+    'Singapore',
+    'Monthly',
+    'Compensation',
+    'Valid until',
+    'Unofficial',
+    '2030-01-31T23:59:59.000Z',
+  ])
+    expect(html).toContain(text);
+  expect(html).not.toContain('Resets at');
+  expect(html).not.toContain('NaN');
+  expect(html).not.toContain('Infinity');
+  expect(html).toContain('https://platform.xiaomimimo.com/#/console/plan-manage');
+  expect(html).toContain('<button');
+});
+test('unconfigured, auth expiry, unavailable, stale, expired and exhausted remain distinct', () => {
+  expect(render({ kind: 'unconfigured' })).toContain('Not configured');
+  expect(render({ kind: 'unavailable' })).toContain('Unavailable');
+  expect(
+    render({ kind: 'ready', snapshot: { ...sample, error: 'auth_required', stale: true } })
+  ).toContain('Session required');
+  expect(render({ kind: 'ready', snapshot: sample }, Date.parse('2030-01-01T00:11:00Z'))).toContain(
+    'Stale'
+  );
+  expect(render({ kind: 'ready', snapshot: { ...sample, expired: true } })).toContain('Expired');
+  const exhausted = structuredClone(sample);
+  exhausted.pools[0] = {
+    ...exhausted.pools[0],
+    used: '11000000000',
+    remaining: '0',
+    remainingPercent: '0.00',
+  };
+  const html = render({ kind: 'ready', snapshot: exhausted });
+  expect(html).toContain('0.00%');
+  expect(html).not.toContain('Not configured');
+});
