# Example user units. This one is the manual retry (XQ_MANUAL_COMMAND starts it);
# xiaomi-session-refresh.timer starts xiaomi-session-refresh-scheduled.service
# instead. Both read the XQ_* settings from one file (example: env.example) and
# differ only in XQ_TIMER_RUN, so a timer run backs off and this unit never does.
# Install a copy of the refresher directory, the env file and all three units,
# run the end-to-end smoke test in docs/session-renewal.md (Installation), then:
# systemctl --user daemon-reload && systemctl --user enable --now xiaomi-session-refresh.timer
# ssh runs with BatchMode=yes: key auth only, known_hosts already trusted, and
# an unencrypted key or an SSH_AUTH_SOCK agent visible to the user manager.
# Neither unit passes --rebind, so a renewal only replaces a session of the
# same Xiaomi account (userId); otherwise it reports account_mismatch (exit 3).
# The first install (no session on the collector host yet) and a deliberate
# account switch need one direct run with the env file plus --rebind
# (add --force if the collector is healthy); then update ACCOUNT_LABEL.
# The run stops itself after 120 s, then closes its tab (2 s) and a browser it
# started (3 s), writes its status (20 s) and may send one desktop notification
# (5 s): about 150 s in total, under TimeoutStartSec. SIGTERM closes the tab
# before exiting. Run state (backoff, notifications) lives in StateDirectory;
# the run lock is $XDG_RUNTIME_DIR/xiaomi-session-refresh.lock.
[Unit]
Description=Renew the Xiaomi MiMo collector session now (manual retry, never backs off)

[Service]
Type=oneshot
TimeoutStartSec=180
StateDirectory=xiaomi-session-refresh-state
StateDirectoryMode=0700
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/xiaomi-session-refresh/env
# Applied after every other source, so neither the env file nor the user
# manager's environment can make a manual retry back off.
UnsetEnvironment=XQ_TIMER_RUN
ExecStart=/usr/bin/env bun %h/.local/share/xiaomi-session-refresh/refresh-session.ts
NoNewPrivileges=yes
