# Settings for both units (EnvironmentFile=). Install as
# ~/.config/xiaomi-session-refresh/env (directory 0700, file 0600) and replace
# the placeholders. systemd reads it, and so does sh in the smoke test
# (set -a; . file): one KEY=value per line, double quotes around a value with
# spaces, absolute paths (neither %h nor ~ is expanded by systemd). No secrets.
# Never set XQ_TIMER_RUN here; only the timer's unit sets it.
XQ_CDP_URL=http://127.0.0.1:9223
XQ_SSH_TARGET=user@collector-host.example
XQ_REMOTE_DIR=/srv/xiaomi-quota/session
XQ_COLLECTOR_CONTAINER=xiaomi-quota
# Shown on the page, in notifications and in backoff lines: the manual unit.
XQ_MANUAL_COMMAND="systemctl --user start xiaomi-session-refresh.service"
#XQ_HOST_LABEL=workstation
# Optional: start the renewal browser when needed (refresher/examples), and a
# desktop notification when a person is needed.
#XQ_BROWSER_LAUNCH=/home/user/.local/share/xiaomi-session-refresh/launch-browser-hyprland.sh
#XQ_NOTIFY=desktop
