# Every 5 minutes. Calendar runs missed during suspend fire on resume; Persistent=true
# also catches up runs missed while the user manager was not running.
# Starts the backing-off unit; manual retries use xiaomi-session-refresh.service.
[Unit]
Description=Check the Xiaomi MiMo collector session every 5 minutes

[Timer]
OnCalendar=*:0/5
Persistent=true
Unit=xiaomi-session-refresh-scheduled.service

[Install]
WantedBy=timers.target
